#!/usr/bin/env bash
# Refuse to commit an excluded path or an oversized file.
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$DIR/guard.sh"

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[[ -z "$staged" ]] && exit 0

offenders="$(printf '%s\n' "$staged" | match_excluded)"
[[ -n "$offenders" ]] && fail_paths "staged path is excluded from this repository" "$offenders"

# Size check against the staged content, not the working tree.
big=""
while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    size="$(git cat-file -s "$(git rev-parse ":$f" 2>/dev/null)" 2>/dev/null || echo 0)"
    (( size > MAX_BYTES )) && big+="$(printf '%s (%s.%s MB)' "$f" \
        "$((size / 1024 / 1024))" "$(( (size * 10 / 1024 / 1024) % 10 ))")"$'\n'
done <<< "$staged"
[[ -n "$big" ]] && fail_size "$big"

# Copyright. No published file may reproduce a run of RH124 or RH134 wording.
# The rule is non-negotiable, so it is machine-checked rather than trusted to
# whoever is writing that day.
#
# This runs only when markdown is staged, and only when the extracted
# courseware is present. The extracts live in .private and are not in the
# repository, so on a fresh clone there is nothing to compare against and the
# check stands aside rather than blocking every commit.
#
# It reads the working tree rather than the staged content. For a single
# maintainer those are the same thing, and reading the index would mean
# rebuilding every file in a temporary directory for no gain here.
if printf '%s\n' "$staged" | grep -q '\.md$'; then
    root="$(git rev-parse --show-toplevel)"
    harness="$root/.private/source/verify_practice.py"
    if [[ -f "$harness" && -f "$root/.private/source/extracted/RH124.txt" ]] \
        && command -v python3 >/dev/null 2>&1; then
        if ! out="$(python3 "$harness" 2>&1)"; then
            printf '%s\n' "$out" | grep -E '^\s+FAIL' >&2
            echo "" >&2
            echo "  Refusing the commit. Fix the above, then commit again." >&2
            echo "  Cut the offending text. Do not reword it, because the" >&2
            echo "  structure is the thing that infringes." >&2
            exit 1
        fi
    fi
fi

exit 0
