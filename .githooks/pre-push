#!/usr/bin/env bash
# Re-check every commit being pushed, so a --no-verify commit is still caught
# before it can become public. This is the last line of defence.
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$DIR/guard.sh"

ZERO="0000000000000000000000000000000000000000"
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [[ "$local_sha" == "$ZERO" ]] && continue          # branch deletion

    if [[ "$remote_sha" == "$ZERO" ]]; then
        # New branch: inspect every commit not already on another remote ref.
        range=("$local_sha" --not --remotes)
    else
        range=("$remote_sha..$local_sha")
    fi

    files="$(git rev-list "${range[@]}" --objects 2>/dev/null | awk '{ $1=""; sub(/^ /, ""); print }' | sort -u)"
    [[ -z "$files" ]] && continue

    offenders="$(printf '%s\n' "$files" | match_excluded)"
    if [[ -n "$offenders" ]]; then
        fail_paths "a commit being pushed contains an excluded path" "$offenders"
    fi

    # The tree is only half of what gets published. A commit made with
    # --no-verify skips the commit-msg hook, so its message has never been
    # checked. Read every message in the range and refuse the push if one
    # names a file inside an ignored directory.
    while IFS= read -r sha; do
        [[ -z "$sha" ]] && continue
        check_message_text "a commit being pushed ($(git log -1 --format=%h "$sha"))" \
            "$(git log -1 --format=%B "$sha")"
    done < <(git rev-list "${range[@]}" 2>/dev/null)
done

exit $status
